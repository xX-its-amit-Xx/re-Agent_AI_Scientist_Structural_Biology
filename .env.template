# Copy to `.env` and fill in. `.env` is gitignored.
#
# Every secret this project can use is listed here with an empty value, including
# ones nobody has needed yet. An undocumented credential is a credential the next
# person rediscovers the hard way.

# --- LLM ------------------------------------------------------------------
# The pipeline runs on the Claude Code subscription today; this is for when it
# runs as an API-driven agent instead.
ANTHROPIC_API_KEY=

# --- Structure prediction / co-folding ------------------------------------
BOLTZ_API_KEY=
OPENPROTEIN_API_KEY=
TAMARIND_API_KEY=

# --- Protein language models ----------------------------------------------
ESMC_API_KEY=

# --- Compute --------------------------------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Data sources ---------------------------------------------------------
# Only needed for gated sources. `source-scout` records which datasets need a
# key in the DataRef's fetch_hint, so check there before hunting for one.
KAGGLE_USERNAME=
KAGGLE_KEY=
HF_TOKEN=
CHEMBL_API_KEY=

# --- Literature -----------------------------------------------------------
# Paperclip authenticates automatically over MCP; this is only for a local CLI.
PAPERCLIP_API_KEY=

# --- Run identity ---------------------------------------------------------
REAGENT_RUN_OWNER=
